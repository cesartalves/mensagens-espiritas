

<h1>Mensagens Espírituais</h1>

Receba diariamente, via SMS, uma frase inspiradora de figuras como Chico Xavier, André Luiz e Emmanuel.
<br>
Totalmente gratuito!

<% if flash[:notice] %>
  <div class="notice">
    <%= flash[:notice] %>
  </div>
<% end %>

<%= form_with url: "/subscribe", method: :post do |form| %>
  <div>
    <%= form.label :ddi, "DDI" %>
    <%= form.text_field :ddi, value: "55", required: true %>
  </div>

  <div>
    <%= form.label :ddd, "DDD" %>
    <%= form.text_field :ddd, placeholder: "14", required: true %>
  </div>

  <div>
    <%= form.label :number, "Número" %>
    <%= form.text_field :number, placeholder: "981186243", required: true %>
  </div>

  <%= form.submit "Cadastrar" %>
<% end %>